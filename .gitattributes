# Normalize line endings: store LF in the repo, check out native on Windows.
* text=auto

*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf

# Binary assets — never touch EOLs.
*.webp  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.db    binary
*.pt    binary
*.pth   binary
